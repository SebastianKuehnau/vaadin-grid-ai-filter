<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dev.demo.vaadin</groupId>
		<artifactId>grid-ai-filter-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>benchmark</artifactId>
	<name>model benchmark</name>
	<description>Measures the local Ollama models against the four filtering approaches: correctness,
		latency, tokens and resident model size. No numeric prefix — not a step of the talk, and never
		started by a build. Every setting is documented in benchmark-example.yaml.</description>

	<dependencies>
		<dependency>
			<!-- The domain layer, the CustomerSearchAgent seam and the per-call token measurement. -->
			<groupId>dev.demo.vaadin</groupId>
			<artifactId>00-commons</artifactId>
			<version>${project.version}</version>
			<exclusions>
				<exclusion>
					<!-- The benchmark never renders a view; keeping Vaadin off saves startup time and RAM. -->
					<groupId>com.vaadin</groupId>
					<artifactId>vaadin-spring-boot-starter</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<!-- Only the native Ollama binding: this benchmark measures local models. -->
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-ollama</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<!-- The worker/orchestrator handover and the JSON report. -->
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Named explicitly: BenchmarkWorker has a main method too, so auto-detection
					     would find two candidates and fail. -->
					<mainClass>dev.demo.vaadin.aigridfilter.benchmark.BenchmarkApplication</mainClass>
				</configuration>
				<executions>
					<execution>
						<!-- No fat jar: the orchestrator forks worker JVMs and needs a real, listable
						     classpath to hand them (see WorkerLauncher). Run it with spring-boot:run. -->
						<id>repackage</id>
						<phase>none</phase>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
