<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dev.demo.vaadin</groupId>
		<artifactId>grid-ai-filter-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>demo-commons</artifactId>
	<name>demo commons</name>
	<description>Shared runtime infrastructure: the domain layer, the shared Vaadin components, the AI
		layer's seam towards the view and the token measurement. No numeric prefix — this is not a demo
		step. Never holds an AI service, a filter type, a system prompt or a @Route; see its README.</description>

	<!-- A plain jar on purpose: no spring-boot-maven-plugin (nothing to repackage, no main class) and
	     no vaadin-maven-plugin (this module contributes no @Route and no frontend resources, so
	     build-frontend has nothing extra to do). -->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.vaadin</groupId>
			<artifactId>vaadin-spring-boot-starter</artifactId>
		</dependency>

		<!-- A regular dependency, not <optional>, so that TokenUsageAdvisor can simply be a @Component:
		     it lives in dev.demo.vaadin.aigridfilter.ai, every app scans that package, and one annotation
		     replaces the three identical @Configuration classes 02/03/04 used to need.

		     The price is deliberate and measured: 01-non-ai-filter resolves 17 further artefacts through
		     this line (the four Spring AI jars plus jtokkit, the victools JSON-Schema modules, ANTLR/ST4,
		     micrometer-core, spring-messaging). It writes no Spring AI code and autoconfigures no
		     ChatModel — no spring-ai-starter-model-* is on its classpath — so nothing there is reachable
		     except an idle TokenUsageAdvisor bean. Making it <optional> again would bring the three
		     configuration classes back; that trade was weighed and settled, see demo-commons/README.md. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-client-chat</artifactId>
		</dependency>

		<!-- Only for this module's own CanonicalQuerySetConsistencyTest, which guards the four ITs' copies
		     of the canonical query set against docs/canonical-query-set.md. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
